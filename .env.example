# --- Supabase (geteiltes Projekt "Tool Hub energetisiert." -- Auth + Rechte fuer alle 5 Tools) ---
NEXT_PUBLIC_SUPABASE_URL=https://gsmuqvjyfjtjbbxqmfgt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key aus diesem Projekt>
# Nur fuer approve_profile() (Compare-and-Swap-Freischaltung), niemals im Client-Bundle.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key aus diesem Projekt>

# --- Security ---
# Pflicht, KEIN Fallback: signiert den Freischaltungs-Link in der Admin-Mail
# (HMAC, Profil-ID im Payload, 24h TTL). Muss mit dem Secret der Edge Function
# uebereinstimmen, die die Mail verschickt -- sonst schlaegt die Bestaetigung
# still fehl statt unsicher durchzugehen.
REQUEST_TOKEN_SECRET=<zufaelliger-langer-string>
# Optional: eigener Salt fuer die Rate-Limit-Schluessel (Hash von IP bzw.
# Ziel-E-Mail). Ohne diesen Wert wird REQUEST_TOKEN_SECRET mitverwendet -- das
# genuegt, ein getrennter Salt ist nur sauberer (ein kompromittierter Wert
# reisst den anderen dann nicht mit). openssl rand -hex 32
# IP_SALT=
# Erlaubte Origins fuer Signup/Login-Actions (kommagetrennt).
ALLOWED_ORIGINS=https://tools.energetisiert.de,https://energetisiert.de

# --- Benachrichtigung bei neuer Registrierung ---
NOTIFY_ADMIN_EMAIL=info@energetisiert.de
